{
  "name": "annal",
  "version": "0.0.1",
  "description": "A lightweight logger library for JavaScript",
  "keywords": [
    "console",
    "debug",
    "debugger",
    "log",
    "logger",
    "logging",
    "slog"
  ],
  "homepage": "https://github.com/xueelf/annal",
  "bugs": {
    "url": "https://github.com/xueelf/annal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/annal.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build/index.ts",
    "test": "bun test scripts/test",
    "format": "prettier **/*.ts --write",
    "lint": "eslint **/*.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^20.5.0",
    "@types/bun": "^1.3.13",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-sort": "^0.1.0",
    "typescript-eslint": "^8.59.1"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
