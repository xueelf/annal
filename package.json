{
  "name": "annal",
  "version": "0.2.1",
  "description": "A lightweight logger library for JavaScript",
  "keywords": [
    "console",
    "debug",
    "debugger",
    "log",
    "logger",
    "logging",
    "slog"
  ],
  "homepage": "https://github.com/xueelf/annal",
  "bugs": {
    "url": "https://github.com/xueelf/annal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/annal.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./dist/*.d.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{json,md,ts,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.1.1",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
